{
  "schema_version": "1.0",
  "id": "standard-assessment",
  "version": "1.0.0",
  "description": "General assessment configuration and evidence governance; no target action permissions are granted.",
  "defaults": {
    "artifact_handling": "no-download",
    "classification": "restricted",
    "retention_days": 30,
    "report_contract": "engagement",
    "maximum_impact": "low",
    "stop_conditions": "Pause on unexpected impact, sensitive data exposure, scope ambiguity, or an owner request."
  },
  "policy": {
    "scope_boundary": "explicit-assets-only",
    "proof_standard": "minimum-sufficient-evidence",
    "rce_validation": "requires-explicit-human-review-and-minimal-evidence",
    "stop_after_confirmation": true,
    "prohibited": ["automatic-scope-expansion", "automatic-technique-progression"],
    "required_evidence": ["asset-reference", "collection-time", "source-reference", "finding-review", "sensitive-data-minimization"]
  }
}
